{
	"name": "capnp-ls-client",
	"description": "A language client of Cap'n Proto Language Server",
	"author": "Atsushi Tomida",
	"license": "MIT",
	"version": "0.3.5",
	"packageManager": "pnpm@11.5.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/trickstar0301/capnp-ls"
	},
	"publisher": "tomitty",
	"categories": [],
	"keywords": [
		"capnp",
		"cap'n proto",
		"capnproto",
		"capnp-ls",
		"capnp-vscode",
		"capnp-ls-client"
	],
	"engines": {
		"vscode": "^1.91.0"
	},
	"activationEvents": [
		"onLanguage:capnp"
	],
	"main": "./client/out/extension",
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "Cap'n Proto",
			"properties": {
				"capnp-ls-client.languageServer.path": {
					"type": "string",
					"default": "",
					"description": "Explicit path to the Cap'n Proto language server executable"
				},
				"capnp-ls-client.languageServer.version": {
					"type": "string",
					"default": "v0.0.5",
					"description": "capnp-ls release tag used for automatic Linux x86_64 and macOS arm64 downloads"
				},
				"capnp-ls-client.languageServer.capnpChannel": {
					"type": "string",
					"enum": [
						"v1",
						"v2"
					],
					"default": "v1",
					"description": "Cap'n Proto compatibility channel for automatically downloaded language server binaries"
				},
				"capnp-ls-client.server.extraEnv": {
					"type": [
						"null",
						"object"
					],
					"additionalProperties": {
						"type": [
							"string",
							"number"
						]
					},
					"default": null,
					"markdownDescription": "Extra environment variables that will be passed to the capnp-ls executable."
				}
			}
		},
		"languages": [
			{
				"id": "capnp",
				"extensions": [
					".capnp"
				],
				"aliases": [
					"Cap'n Proto",
					"capnp",
					"capnproto"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "capnp",
				"scopeName": "source.capnp",
				"path": "./syntaxes/capnp.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm compile",
		"compile": "tsc -b && esbuild client/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=client/out/extension.js",
		"watch": "tsc -b -w",
		"lint": "eslint ./client/src  --ext .ts,.tsx",
		"test": "tsc -b && sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.9.2",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"esbuild": "^0.28.0",
		"eslint": "^10.4.1",
		"mocha": "^11.7.6",
		"typescript": "^6.0.3"
	}
}
